# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Caraml: a small interpreted language (learning project)"
description:
  "An OCaml-implemented interpreter for Caraml, a small language with syntax inspired by OCaml and Rust."
maintainer: ["marcos.flavio@justtraveltour.com"]
authors: ["Marcos Flavio"]
homepage: "https://github.com/MarcosFlavioGS/Caraml"
bug-reports: "https://github.com/MarcosFlavioGS/Caraml/issues"
depends: [
  "ocaml" {>= "5.0"}
  "dune" {>= "3.18"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/MarcosFlavioGS/Caraml.git"
x-maintenance-intent: ["(latest)"]
